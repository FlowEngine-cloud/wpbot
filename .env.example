# ---- AI (OpenAI-compatible endpoint) ----
# Point this at any OpenAI-compatible gateway.
# FlowEngine users: use your LiteLLM gateway URL. Or Anthropic's compat endpoint.
AI_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=sk-your-key

# Fast + cheap model for per-message moderation. Smart model for the nightly digest.
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_SMART=claude-opus-4-8

# ---- App ----
PORT=3000
# Where the SQLite db and the WhatsApp session live. Docker sets this to the
# /data volume; leave it unset locally and both stay in the repo root.
# DATA_DIR=/data

# ---- Privacy ----
# Delete stored message text after N hours (digest reads within this window).
MESSAGE_TTL_HOURS=48
